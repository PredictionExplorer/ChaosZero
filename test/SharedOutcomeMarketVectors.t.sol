pragma solidity 0.8.35;

import {Test} from "forge-std/Test.sol";
import {SharedOutcomeMarket, ISharedCollateral} from "../src/SharedOutcomeMarket.sol";
import {Log2Bounds} from "../src/libraries/Log2Bounds.sol";
import {SharedTestSource} from "./SharedOutcomeMarket.t.sol";
import {MockCst} from "./utils/Mocks.sol";

/// @dev Machine-readable JSON lines generated by actual Solidity execution.
/// Run `forge test --match-contract SharedOutcomeMarketVectorsTest -vv`.
contract SharedOutcomeMarketVectorsTest is Test {
    SharedOutcomeMarket private market;
    SharedTestSource private source;

    function setUp() public {
        MockCst token = new MockCst();
        source = new SharedTestSource();
        source.set(1, true, false, 0, 0);
        market = new SharedOutcomeMarket(ISharedCollateral(address(token)), source);
        token.mint(address(this), 1_000_000e18);
        token.approve(address(market), type(uint256).max);
        market.fundRound(1, 1000e18);
    }

    function test_emitLogVectors() public {
        uint256[14] memory inputs = [
            uint256(1),
            2,
            3,
            10,
            1e12 - 1,
            1e12,
            1e18 - 1,
            1e18,
            1000e18,
            (uint256(1) << 64) - 1,
            uint256(1) << 64,
            (uint256(1) << 120) - 1,
            uint256(1) << 120,
            667601134098543439318150072872112656
        ];
        for (uint256 i; i < inputs.length; ++i) {
            (uint256 lower, uint256 upper) = Log2Bounds.bounds(inputs[i]);
            emit log(string.concat(
                    "SHARED_VECTOR {\"kind\":\"log\",\"input\":\"",
                    vm.toString(inputs[i]),
                    "\",\"lower\":\"",
                    vm.toString(lower),
                    "\",\"upper\":\"",
                    vm.toString(upper),
                    "\"}"
                ));
        }
    }

    function test_emitTradeVectors() public {
        _vector("uniform-yes-conservative", 0, true, true, 100e18, 150e18);
        _vector("uniform-yes-too-many", 0, true, true, 100e18, 200e18);
        _vector("uniform-no-conservative", 7, false, true, 100e18, 150e18);
        uint256 seed = 1000e18;
        uint256 exact = 100e18 + seed - (seed * seed + 1100e18 - 1) / 1100e18;
        _vector("uniform-analytic-boundary", 0, true, true, 100e18, exact);
        _vector("uniform-safe-boundary", 0, true, true, 100e18, exact - 1_000_000);
        market.buy(1, 0, true, 100e18, 150e18, type(uint256).max);
        _vector("skewed-other-question", 1, false, true, 100e18, 150e18);
        _vector("skewed-same-question", 0, true, true, 100e18, 150e18);
        _vector("sell-safe", 0, true, false, 50e18, 150e18);
        _vector("sell-too-much-cash", 0, true, false, 101e18, 150e18);
        source.set(1, true, false, 1, 1);
        _vector("partial-known-other-question", 1, false, true, 100e18, 150e18);
        _vector("partial-known-trade-blocked", 0, false, true, 100e18, 150e18);
        market.claimKnown(1);
        _vector("after-partial-claim", 1, true, true, 100e18, 150e18);
    }

    function _vector(string memory name, uint8 q, bool yes, bool buy_, uint256 cash, uint256 units) private {
        (uint256 collateral,,,) = market.roundAccounting(1);
        (uint256[8] memory y, uint256[8] memory n) = market.liabilities(1);
        (,, uint8 known, uint8 values) = source.outcomeState(1);
        uint256 snap = vm.snapshotState();
        bytes memory call = buy_
            ? abi.encodeCall(market.buy, (1, q, yes, cash, units, type(uint256).max))
            : abi.encodeCall(market.sell, (1, q, yes, units, cash, type(uint256).max));
        (bool accepted,) = address(market).call(call);
        assertTrue(vm.revertToState(snap));
        emit log(string.concat(
                "SHARED_VECTOR {\"kind\":\"trade\",\"name\":\"",
                name,
                "\",\"collateral\":\"",
                vm.toString(collateral),
                "\",\"yes\":",
                _array(y),
                ",\"no\":",
                _array(n),
                ",\"knownMask\":",
                vm.toString(uint256(known)),
                ",\"values\":",
                vm.toString(uint256(values)),
                ",\"question\":",
                vm.toString(uint256(q)),
                ",\"yesSide\":",
                yes ? "true" : "false",
                ",\"buy\":",
                buy_ ? "true" : "false",
                ",\"cash\":\"",
                vm.toString(cash),
                "\",\"units\":\"",
                vm.toString(units),
                "\",\"accepted\":",
                accepted ? "true" : "false",
                "}"
            ));
    }

    function _array(uint256[8] memory items) private pure returns (string memory result) {
        result = "[";
        for (uint256 i; i < 8; ++i) {
            result = string.concat(result, i == 0 ? "" : ",", "\"", vm.toString(items[i]), "\"");
        }
        return string.concat(result, "]");
    }
}
