+import type { z as legacy } from 'zod/v3';
+import type { z } from 'zod/v4';
+import type { W3mFrameSchema as MessageShapes } from './W3mFrameSchema.js';
+
+// Keep the published message payload shapes while exposing the native v4 methods.
+// Only TypeScript reads the legacy declarations; the actual validators run on v4.
+type FrameValidator<S extends legacy.ZodTypeAny> =
+  z.ZodType<legacy.output<S>, legacy.input<S>> & Pick<z.ZodUnion, 'options'>;
+export declare const W3mFrameSchema: {
+  [K in keyof typeof MessageShapes]: FrameValidator<(typeof MessageShapes)[K]>;
+};
