# Chain to target: 42161 = Arbitrum One (default), 31337 = local anvil.
NEXT_PUBLIC_CHAIN_ID=42161

# The market series contract (GestureSeriesMarket) to display by default.
# Can be overridden per-visit with ?market=0x… in the URL.
NEXT_PUBLIC_MARKET_ADDRESS=

# Previous joint-pool prototype only. Keep blank for the independent engine.
# Shared eight-question local prototype ONLY. The local launcher injects this,
# NEXT_PUBLIC_CHAIN_ID=31337, and its RPC URL automatically. This is a DIFFERENT
# ABI/address from NEXT_PUBLIC_MARKET_ADDRESS. /shared always exposes its screen;
# setting this also selects the shared screen at /. Public-chain writes are
# disabled until a verified live outcome source is integrated.
NEXT_PUBLIC_SHARED_MARKET_ADDRESS=

# Current eight-INDEPENDENT-pool local prototype. The launcher injects this and
# blanks both older market addresses. / and /shared select this ABI only when
# this explicit address is configured. Local chain31337 only.
NEXT_PUBLIC_INDEPENDENT_MARKET_ADDRESS=

# Optional: custom RPC endpoint (falls back to the chain's public RPC).
NEXT_PUBLIC_RPC_URL=

# Optional: block the market was deployed at — speeds up event scans a lot.
NEXT_PUBLIC_DEPLOY_BLOCK=

# Optional: WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Without it, only injected browser wallets (MetaMask, Rabby, …) are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: canonical site origin for SEO (metadata, sitemap, JSON-LD, social
# cards). Defaults to the production domain; set on preview deployments so
# they emit self-consistent absolute URLs.
NEXT_PUBLIC_SITE_URL=

# Optional: search-console ownership proofs. Google Search Console's
# "HTML tag" token (content value only) and Bing Webmaster's msvalidate.01
# token. Needed once for the domain-migration Change of Address flow.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
